# Copy this file to .env and fill in your real values.
# Never commit the real .env file. It is excluded in .gitignore.

# --- Sharadar point-in-time data (Nasdaq Data Link) ---
# Needed to build the offline archive (python data/archive_sharadar.py). After that,
# every command runs from the local cache with zero API calls.
NASDAQ_DATA_LINK_API_KEY=

# --- Interactive Brokers (paper) ---
# TWS or IB Gateway must be running locally with the API enabled.
# 7497 is the default paper trading port. 7496 is live. Keep this on paper.
IB_HOST=127.0.0.1
IB_PORT=7497
IB_CLIENT_ID=1
